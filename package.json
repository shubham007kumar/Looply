{
  "name": "looply-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mobile": "pnpm --filter @looply/mobile start",
    "mobile:ios": "pnpm --filter @looply/mobile ios",
    "mobile:android": "pnpm --filter @looply/mobile android",
    "mobile:web": "pnpm --filter @looply/mobile web"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
